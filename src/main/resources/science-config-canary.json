          "description": "Expand to beta users in a specific region.",
          "durationDays": 14
        },
        {
          "trafficPercentage": 25,
          "description": "Begin rolling out to a percentage of the general user base.",
          "durationDays": 21
        },
        {
          "trafficPercentage": 100,
          "description": "Full rollout to all users.",
          "durationDays": 0
        }
      ]
    },
    "entryGuardClassName": "com.ticketmaster.exp.entry.AudienceEntryGuard",
    "maxSampleSize": 5000000,
    "initialTrafficPercentage": 0,
    "maxTrafficPercentage": 100,
    "comparisonStrategy": {
      "type": "DEEP_EQUAL",
      "ignoreFields": ["timestamp", "requestId"]
    }
  }
}